# Starknet RPC URL (public testnet or mainnet)
# Get a free key from Infura: https://www.infura.io/
STARKNET_RPC=https://starknet-sepolia.infura.io/v3/YOUR_INFURA_KEY

# Optional: Medialane hosted API key (core works without it via on-chain reads)
# Medialane: https://medialane.io
# MEDIALANE_API_KEY=your_medialane_api_key

# Optional: Starkscan API key (for reference server metadata routes)
# STARKSCAN_API_KEY=your_starkscan_api_key
